# ==============================================================================
# Git Ignore - Security & Clean Repository Policy
# ==============================================================================

# Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Environment Variables & Secrets (CRITICAL - Prevent Leaks)
.env
.env.*
*.env
*.key
*.pem
*.cert
*.crt
*.pfx
*.p12
secrets.json
credentials.json
client_secret*.json
id_rsa
id_rsa.*
*.token

# Python Cache & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/

# Jupyter Notebook Checkpoints
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# IDEs & Editors
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
$RECYCLE.BIN/

# Logs & Temporary Files
*.log
scratch/
tmp/
temp/
